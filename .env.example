# ---- CONTENT (free) ----
GEMINI_API_KEY=            # free key from https://aistudio.google.com/apikey
GEMINI_MODEL=gemini-2.5-flash

# ---- GENERAL ----
DRY_RUN=0                  # 1 = generate only, do not publish
PUBLIC_IMAGE_BASE=         # auto-set in GitHub Actions (raw.githubusercontent URL of a PUBLIC repo)

# ---- TELEGRAM (free; also used as the manual package for TikTok/Snapchat) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- LINKEDIN ----
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=       # urn:li:person:xxxx  or  urn:li:organization:xxxx
LINKEDIN_VERSION=202606

# ---- META (Instagram + Facebook Page) ----
META_ACCESS_TOKEN=         # long-lived Page access token
INSTAGRAM_BUSINESS_ID=
FACEBOOK_PAGE_ID=
GRAPH_VERSION=v23.0

# ---- X (pay-per-use, ~US$0.015 per plain post) ----
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# ---- PINTEREST ----
PINTEREST_ACCESS_TOKEN=
PINTEREST_BOARD_ID=
PINTEREST_LINK=            # your website URL
